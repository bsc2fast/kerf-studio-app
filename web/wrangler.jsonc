{
  // Cloudflare Worker that serves the Kerf web app (hosted edition).
  // The same app/ codebase; on the hosted edition it feature-detects "no bridge"
  // and shows Export / Save-to-USB-stick + a Download-Kerf note (no LAN send).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kerf",
  "compatibility_date": "2025-01-01",
  "main": "src/index.js",

  // Serve the shared web app as static assets (one source of truth).
  "assets": {
    "directory": "../app",
    "binding": "ASSETS"
  }

  // ---- Custom domain (uncomment once sankhacooray.com's zone is on Cloudflare) ----
  // "routes": [
  //   { "pattern": "kerf.sankhacooray.com", "custom_domain": true }
  // ]
  // If the zone is NOT on Cloudflare, this Worker still deploys to
  // https://kerf.<your-subdomain>.workers.dev — usable immediately, and you can
  // point kerf.sankhacooray.com at it later.
}
